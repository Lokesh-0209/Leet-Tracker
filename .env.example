# -----------------------------------------------------------------------------
# Leet Tracker Environment Configuration Template
# NOTE: The application reads real environment variables provided by the host
# or container runtime. Netlify Database supplies its managed Postgres URL at runtime.
# In production, pass these directly into your deployment environment.
# In local development, you may load them using your preferred shell or runner.
# -----------------------------------------------------------------------------

# Port and network interface host to bind (defaults: PORT=3000, HOST=0.0.0.0)
PORT=3000
HOST=0.0.0.0

# Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# Local development only: SQLite database file (defaults to ./data/leet-tracker.db).
# Set DATABASE_URL to use PostgreSQL locally or in another production environment.
DATABASE_PATH=./data/leet-tracker.db
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Reverse Proxy Trust Configuration (TRUST_PROXY)
# Configures Express 'trust proxy' behavior for reliable req.ip extraction:
# - On Render, AWS ALB, or GCP Cloud Run: set to '1' (trusts 1 upstream reverse proxy hop).
# - On direct internet-facing servers without a reverse proxy: set to 'false' (prevents IP spoofing via client headers).
# - Behind multi-hop load balancers / CDNs: set to hop count (e.g. '2') or specific CIDR ranges.
TRUST_PROXY=false

# Verification Secret (HMAC-SHA256 Server Secret)
# Used to key the hash of temporary 6-digit LeetCode profile verification challenge codes.
# Prevents offline precomputation / rainbow table attacks against the small 6-digit space.
# REQUIRED in production mode (minimum 16 characters).
VERIFICATION_SECRET=replace_with_a_secure_random_key_at_least_16_characters_long

# Session & Cookie Architecture (Handled internally by application)
# - Cookie Name: leet_session
# - HttpOnly: true (prevents client-side script / XSS access)
# - SameSite: Lax (allows top-level navigation while guarding against CSRF)
# - Secure: true in production (requires HTTPS), false in local development
# - Max-Age: 604800 (7 days)

# Optional Rate Limiter Tuning
# AUTH_LOGIN_MAX_ATTEMPTS=5       # Max failed login attempts per account+IP before 15m delay (default: 5)
# AUTH_LOGIN_IP_MAX_ATTEMPTS=20   # Max login requests per IP before 15m delay (default: 20)
# AUTH_VERIFY_MAX_ATTEMPTS=15    # Max verification attempts per IP (default: 15)
# RATE_LIMIT_WINDOW_MS=900000    # Rate limit sliding window in milliseconds (default: 15 minutes)
