# -----------------------------------------------------------------------------
# Leet Tracker Environment Configuration Template
# NOTE: The application reads real environment variables provided by the host
# or container runtime (e.g. Render, Docker, systemd, or shell export).
# In production, pass these directly into your deployment environment.
# In local development, you may load them using your preferred shell or runner.
# -----------------------------------------------------------------------------

# Port and network interface host to bind (defaults: PORT=3000, HOST=0.0.0.0)
PORT=3000
HOST=0.0.0.0

# Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# Path to the SQLite database file (defaults to ./data/leet-tracker.db)
DATABASE_PATH=./data/leet-tracker.db

# HTTP Basic Auth credentials
# - APP_USERNAME: Login username (defaults to "leet" if omitted)
# - APP_PASSWORD: Required in production (minimum 12 characters).
#                 In non-production, if omitted, the authentication gate is disabled.
APP_USERNAME=leet
APP_PASSWORD=your_secure_password_at_least_12_chars_here
