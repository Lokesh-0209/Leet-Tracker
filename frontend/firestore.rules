rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: questions
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required) - UID of the owner
    //   - title: string (required, 1-200 chars)
    //   - url: string (required, valid URL)
    //   - difficulty: string (required, Easy/Medium/Hard)
    //   - userRating: string (required, Easy/Medium/Hard)
    //   - notes: string (required, max 10000 chars)
    //   - createdAt: timestamp (required)
    //   - nextReviewAt: timestamp (required)
    //   - reviewCount: number (required, 0-3)
    //   - isCompleted: bool (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidQuestion(data) {
      return data.userId is string &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.url is string && (data.url.matches("^https://.*") || data.url.matches("^http://.*")) &&
             data.difficulty in ["Easy", "Medium", "Hard"] &&
             data.userRating in ["Easy", "Medium", "Hard"] &&
             data.notes is string && data.notes.size() <= 10000 &&
             data.createdAt is timestamp &&
             data.nextReviewAt is timestamp &&
             data.reviewCount is number && data.reviewCount >= 0 && data.reviewCount <= 3 &&
             data.isCompleted is bool;
    }

    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "ryagatlakiran777@gmail.com" && 
             request.auth.token.email_verified == true;
    }

    match /questions/{questionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId) && isValidQuestion(request.resource.data);
      allow update: if isOwner(resource.data.userId) && 
                       isOwner(request.resource.data.userId) && 
                       isValidQuestion(request.resource.data);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
